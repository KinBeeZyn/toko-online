# Salin file ini menjadi ".env" lalu sesuaikan nilainya

# Untuk MongoDB lokal:
MONGO_URI=mongodb://127.0.0.1:27017/toko_online

# Atau untuk MongoDB Atlas (cloud), contoh:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/toko_online

PORT=5000

# Kunci rahasia untuk membuat & memverifikasi token JWT.
# WAJIB diganti dengan string acak yang panjang & rahasia sebelum deploy ke publik.
# Contoh cara generate: jalankan `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=ganti_dengan_string_rahasia_yang_panjang_dan_acak

# URL frontend yang sudah di-deploy (untuk konfigurasi CORS di production).
# Contoh: FRONTEND_URL=https://toko-online-kamu.vercel.app
# Kosongkan/hapus baris ini saat development lokal.
FRONTEND_URL=
